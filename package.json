    "serve-static": "1.16.3",
    "socket.io": "4.8.3",
    "split": "1.0.1",
    "swagger-ui-express": "^5.0.1",
    "temp": "0.9.4",
    "tmp-promise": "^3.0.3",
    "transliteration": "2.2.0",
    "tsx": "4.20.3",
    "uuid": "^14.0.1",
    "werift": "^0.24.3",
    "ws": "8.21.1",
    "yargs": "^17.7.2",
    "yauzl": "2.10.0",
    "zeromq": "6.4.2"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.11.1",
    "@types/bluebird": "^3.5.42",
    "@types/chalk": "^0.4.31",
    "@types/chrome-remote-interface": "^0.31.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-session": "^2.0.49",
    "@types/csurf": "^1.11.5",
    "@types/eventemitter3": "^1.2.0",
    "@types/express": "^5.0.1",
    "@types/http-proxy": "^1.17.16",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.15.17",
    "@types/semver": "^7.7.1",
    "@types/split": "^1.0.5",
    "@types/temp": "^0.9.4",
    "@types/tmp": "^0.2.6",
    "@types/ws": "^3.2.1",
    "cli-docs-generator": "1.0.7",
    "eslint": "^9.30.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "overrides": {
    "busboy": "npm:@fastify/busboy@1.2.1",
    "lodash": "4.18.1",
    "qs@6.5.1": "6.5.3",
    "xml2js": "0.5.0",
    "socket.io-parser": "4.2.7",
    "request": "$request",
    "validator": "13.15.35",
    "node-forge": "1.4.0",
    "axios": "1.18.1"
  },
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10"
  }
}
