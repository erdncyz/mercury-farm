{
  "name": "mercury-device-farm",
  "version": "0.7.9",
  "description": "Mercury Device Farm - Remote Device Management Platform",
  "type": "module",
  "keywords": [
    "adb",
    "android",
    "ios",
    "mercury",
    "test",
    "remote"
  ],
  "bin": {
    "mercury": "./bin/mercury.mjs",
    "dh": "./bin/mercury.mjs"
  },
  "yargs": {
    "duplicate-arguments-array": false
  },
  "scripts": {
    "doc": "cli-docs-generator --cli=mercury --pretty_cli_name=mercury -o ./units.md",
    "lint": "eslint ./lib",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:h264-webrtc": "node --test test/scrcpy-video-stream-parser.test.js test/android-webrtc-transport.test.js test/ios-h264-capture.test.js",
    "build:swagger:ui": "cd ./ui && npm run generate-api",
    "build:swagger:routes": "cd ./lib/units/api && python3 ./gen_routes.py",
    "build:swagger": "npm run build:swagger:routes && npm run build:swagger:ui",
    "protoc": "npx protoc --ts_out ./lib/wire --ts_opt generate_dependencies --proto_path ./lib/wire ./lib/wire/wire.proto",
    "build": "tsc -p tsconfig.node.json",
    "dev": "tsx ./bin/mercury.mjs",
    "ui:build": "npm --prefix ./ui run build:prod",
    "ui:watch": "npm --prefix ./ui run build:prod:watch",
    "ui:commit": "bash scripts/ui-commit.sh",
    "mercury:domain:auto": "./scripts/update-mercury-domain.sh scripts/variables.env",
    "prestack:up:macos": "npm run -s mercury:domain:auto",
    "stack:up:macos": "docker compose -f docker-compose-macos.yaml --env-file scripts/variables.env up -d --build",
    "stack:pull:macos": "docker compose -f docker-compose-macos.yaml --env-file scripts/variables.env pull",
    "prestack:up:image:macos": "npm run -s mercury:domain:auto && npm run -s stack:pull:macos",
    "stack:up:image:macos": "docker compose -f docker-compose-macos.yaml --env-file scripts/variables.env up -d --no-build --remove-orphans",
    "stack:ps:macos": "docker compose -f docker-compose-macos.yaml --env-file scripts/variables.env ps"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/credential-providers": "^3.1093.0",
    "@devicefarmer/adbkit-apkreader": "3.2.4",
    "@devicefarmer/minicap-prebuilt": "npm:@u4/minicap-prebuilt@1.1.2",
    "@devicefarmer/minitouch-prebuilt": "1.3.0",
    "@devicefarmer/stf-browser-db": "1.0.2",
    "@devicefarmer/stf-device-db": "1.4.0",
    "@devicefarmer/stf-syrup": "1.0.2",
    "@devicefarmer/stf-wiki": "1.0.0",
    "@irdk/usbmux": "^0.2.2",
    "@julusian/jpeg-turbo": "3.0.1",
    "@node-saml/passport-saml": "5.1.0",
    "@protobuf-ts/runtime": "^2.11.1",
    "@sentry/node": "^10.67.0",
    "@u4/adbkit": "^5.1.7",
    "appium-sdb": "^1.0.1-beta.1",
    "basic-auth": "1.1.0",
    "bluebird": "2.11.0",
    "body-parser": "^2.3.0",
    "bufferutil": "4.0.7",
    "chalk": "1.1.3",
    "chrome-remote-interface": "^0.33.3",
    "cookie-parser": "^1.4.6",
    "cookie-session": "2.1.1",
    "csurf": "1.11.0",
    "debug": "4.3.4",
    "eventemitter3": "1.2.0",
    "express": "5.2.1",
    "express-openapi": "^12.1.3",
    "express-rate-limit": "7.3.1",
    "express-validator": "4.3.0",
    "fast-printf": "^1.6.10",
    "form-data": "^4.0.6",
    "formidable": "1.2.6",
    "gm": "1.25.1",
    "http-proxy": "1.18.1",
    "jpeg-js": "^0.4.4",
    "jws": "3.2.3",
    "ldapjs": "1.0.2",
    "lodash": "4.18.1",
    "markdown-serve": "0.9.0",
    "minimatch": "3.1.4",
    "mjpeg-consumer": "2.0.0",
    "mongodb": "6.13.0",
    "my-local-ip": "1.0.0",
    "node-simctl": "^7.7.5",
    "nsyslog-parser": "^0.10.1",
    "openid-client": "5.6.5",
    "passport": "0.6.0",
    "passport-oauth2": "1.7.0",
    "postman-request": "^2.88.1-postman.33",
    "promise-socket": "7.0.0",
    "proper-lockfile": "^4.1.2",
    "protobufjs": "5.0.3",
    "proxy-addr": "2.0.7",
    "request": "npm:postman-request@2.88.1-postman.33",
    "request-promise": "4.2.6",
    "rethinkdb": "^2.4.2",
    "rfb2": "^0.2.2",
