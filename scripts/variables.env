MERCURY_SECRET=nosecret
MERCURY_DOMAIN_MODE=auto
MERCURY_DOMAIN=localhost
MERCURY_PORT=443
MERCURY_IMAGE=ghcr.io/erdncyz/mercury-farm:stable
MONGODB_PORT_27017_TCP=mongodb://mercury-mongo:27017
AUTH_URL=auth/mock/

# Opt in only on trusted networks. Docker Desktop needs the macOS ADB server to
# listen beyond loopback to control USB Android devices, which exposes port 5037
# to the local network. iOS-only and untrusted-network installations stay local.
MERCURY_ADB_DOCKER_ACCESS=false

# Screen streaming performance
# 24 fps keeps iOS interaction responsive while staying below the bandwidth and
# encoder cost of 30 fps. Lower this for high-density installations.
SCREEN_FRAME_RATE=24
SCREEN_JPEG_QUALITY=25

# Android + iOS H.264/WebRTC (MJPEG remains the automatic fallback)
SCREEN_WEBRTC_ENABLED=true
SCREEN_WEBRTC_BITRATE=1500000
SCREEN_WEBRTC_MAX_SIZE=1280
SCREEN_WEBRTC_PORT_MIN=13000
SCREEN_WEBRTC_PORT_MAX=13100
IOS_SCREEN_WEBRTC_PORT_MIN=13101
IOS_SCREEN_WEBRTC_PORT_MAX=13200
SCREEN_WEBRTC_TIMEOUT=8000
# When unset, the iOS host provider advertises MERCURY_DOMAIN automatically.
# Set this explicitly when browsers reach Mercury through a different NAT IP.
# SCREEN_WEBRTC_PUBLIC_IP=203.0.113.10
# For NAT-restricted deployments provide STUN/TURN as a JSON array.
SCREEN_WEBRTC_ICE_SERVERS=[]
