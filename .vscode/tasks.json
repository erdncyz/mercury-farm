{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Push release to GitHub",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"origin",
				"HEAD:main"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Push release branch",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"-u",
				"origin",
				"HEAD:release/v0.5.15"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Create release pull request",
			"type": "shell",
			"command": "gh",
			"args": [
				"pr",
				"create",
				"--repo",
				"erdncyz/mercury-farm",
				"--base",
				"main",
				"--head",
				"release/v0.5.15",
				"--title",
				"chore: release v0.5.15",
				"--body",
				"Release verified locally with Ruby contract tests and backend smoke test. Includes the latest main merge plus WDA v16.1.7 and UI submodule updates."
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Wait for release checks",
			"type": "shell",
			"command": "gh",
			"args": [
				"pr",
				"checks",
				"41",
				"--repo",
				"erdncyz/mercury-farm",
				"--watch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Merge release pull request",
			"type": "shell",
			"command": "gh",
			"args": [
				"pr",
				"merge",
				"41",
				"--repo",
				"erdncyz/mercury-farm",
				"--squash",
				"--delete-branch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check release automation",
			"type": "shell",
			"command": "gh",
			"args": [
				"run",
				"list",
				"--repo",
				"erdncyz/mercury-farm",
				"--workflow",
				"auto-version-bump.yml",
				"--limit",
				"3"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect release PR",
			"type": "shell",
			"command": "gh",
			"args": [
				"pr",
				"list",
				"--repo",
				"erdncyz/mercury-farm",
				"--state",
				"all",
				"--limit",
				"10",
				"--json",
				"number,title,state,headRefName,mergedAt"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Validate version bump PR",
			"type": "shell",
			"command": "gh",
			"args": [
				"pr",
				"checks",
