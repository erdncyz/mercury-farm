<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mercury Automation examples (Java) / Mercury Otomasyon örnekleri (Java)
  Run / Çalıştırma:
    mvn -q compile exec:java -Dexec.mainClass=mercury.SingleRun
    mvn -q compile exec:java -Dexec.mainClass=mercury.ParallelRun
    mvn -q compile exec:java -Dexec.mainClass=mercury.SettingsTestPass
    mvn -q compile exec:java -Dexec.mainClass=mercury.SettingsTestFail
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mercury.examples</groupId>
  <artifactId>automation-java</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <exec.cleanupDaemonThreads>false</exec.cleanupDaemonThreads>
  </properties>

  <dependencies>
    <!-- Appium Java client (includes Selenium) — only needed by the test scenarios -->
    <dependency>
      <groupId>io.appium</groupId>
      <artifactId>java-client</artifactId>
      <version>10.1.1</version>
    </dependency>
    <!-- JSON parsing for the Mercury REST client -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
      </plugin>
    </plugins>
  </build>
</project>
